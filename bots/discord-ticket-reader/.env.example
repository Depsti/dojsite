# Nur im Bot-Service setzen. Diese Datei als .env kopieren, niemals Schlüssel committen.
DISCORD_BOT_TOKEN=
DOJ_PORTAL_URL=https://DEINE-WEBAPP.up.railway.app
# Gleicher Ticket-Schlüssel wie beim WebApp-Service, mindestens 32 zufällige Zeichen.
DOJ_DISCORD_TICKET_SECRET=
DOJ_DISCORD_TICKET_GUILD_ID=
DOJ_DISCORD_TICKET_PARENT_IDS=
# Optional: Teilmenge der erlaubten Eltern-IDs, deren Tickets als extern geschlossen gelten.
DOJ_DISCORD_TICKET_CLOSED_PARENT_IDS=
# In Railway ein Volume an /data anhängen. Lokal z. B. ./data verwenden.
BOT_DATA_DIR=/data
BOT_RESYNC_SECONDS=300
BOT_HEARTBEAT_SECONDS=60
BOT_MAX_QUEUE=50000
# Optional: Zeigt nur technischen Zustand, keine Inhalte/Schlüssel. Keine öffentliche Domain nötig.
PORT=3001
