# Nach .env kopieren. Die ausgefüllte .env NIEMALS auf GitHub hochladen.
SUPABASE_URL=https://pllhkkaosbsnroabtdua.supabase.co
# Serverseitiger Secret-Key aus Supabase > Settings > API Keys (sb_secret_...).
SUPABASE_SECRET_KEY=
HOST=127.0.0.1
PORT=3000
# Nur bei HTTPS auf 1 setzen.
DOJ_SECURE_COOKIE=0

# Portal -> Discord: Kanal-Webhook (nur serverseitig speichern).
DISCORD_CASE_WEBHOOK_URL=
# Vertrauliche Fälle nur bewusst für einen geschützten Kanal freischalten.
DISCORD_ALLOW_CONFIDENTIAL=0

# Discord-Bot -> Portal: eigener zufälliger Schlüssel, mindestens 32 Zeichen.
DOJ_DISCORD_IMPORT_SECRET=
# ID einer aktiven Leitung (siehe Portal > Einstellungen).
DOJ_DISCORD_IMPORT_USER_ID=
DOJ_DISCORD_SOURCE=discord
